# LLM (required by default in unified runtime)
OPENAI_API_KEY=
# Cheapest default in src/agent_graph.py; override only if you want another model.
EMO_LLM_MODEL=gpt-5.4-mini

# LangSmith tracing (optional — leave unset to skip)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=explain-my-option
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Tavily Search (optional — vega / event queries). Paste the key locally; never commit it.
TAVILY_API_KEY=

# SEC EDGAR 8-K (optional — residual cue). Free; no API key. SEC requires User-Agent.
# EMO_SEC_USER_AGENT="ExplainMyOption you@example.com"

# Author-local diagnose addendum (optional). Uncomment for incomplete-feed eval.
# Leave unset for demos whose market port already has complete t-1 data.
# EMO_DIAGNOSE_SYSTEM_EXTRA_FILE=
# EMO_DIAGNOSE_SYSTEM_EXTRA=

# Unified graph runtime knobs (applies to app.py)
# EMO_PIPELINE_FEATURES=a1,a2,a3
# EMO_PIPELINE_REQUIRE_KEY=1
# (EMO_SHOWCASE_* aliases still accepted)
# EMO_DIAG_BUDGET=3
# EMO_DIAG_ITERATIONS=2
# EMO_VERIFY_BUDGET=1
# EMO_VERIFIER_MODEL=gpt-5.4-mini
# EMO_DIGEST_MODEL=gpt-5.4-mini
# EMO_CHALLENGER_MODEL=gpt-5.4-mini
